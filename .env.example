# Google Cloud > APIs e serviços > Credenciais. Ativar "Places API (New)".
# Restrinja a chave à Places API. Sem ela o app roda em modo demonstração.
GOOGLE_PLACES_API_KEY=

# Supabase > Project Settings > API (chave publishable/anon, nunca a service_role)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
